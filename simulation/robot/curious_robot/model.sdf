<?xml version="1.0" ?>

<sdf version="1.9">

    <model name="curious_robot">


        <!-- Der Roboter soll von der Physik beeinflusst werden -->
        <static>false</static>


        <!-- ======================================== -->
        <!-- CHASSIS / HAUPTKÖRPER                    -->
        <!-- ======================================== -->
        <link name="chassis">

            <!-- Masse des Chassis -->
            <inertial>
                <mass>2.0</mass>

                <inertia>
                    <ixx>0.0217</ixx>
                    <iyy>0.0417</iyy>
                    <izz>0.0617</izz>

                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyz>0</iyz>
                </inertia>
            </inertial>


            <!-- Physische Form -->
            <collision name="chassis_collision">
                <geometry>
                    <box>
                        <!-- Länge / Breite / Höhe -->
                        <size>0.5 0.4 0.2</size>
                    </box>
                </geometry>
            </collision>


            <!-- Sichtbare Form -->
            <visual name="chassis_visual">
                <geometry>
                    <box>
                        <size>0.5 0.4 0.2</size>
                    </box>
                </geometry>

                <material>
                    <ambient>0.15 0.15 0.15 1</ambient>
                    <diffuse>0.2 0.2 0.2 1</diffuse>
                    <specular>0.3 0.3 0.3 1</specular>
                </material>
            </visual>

            <!-- ======================================== -->
            <!-- 2D-LIDAR, FEST AM CHASSIS                 -->
            <!-- ======================================== -->
            <!-- Gehäuse auf der Oberseite: 0.20/2 + 0.04/2 = 0.12 m -->
            <visual name="lidar_housing">
                <pose>0.125 0 0.12 0 0 0</pose>
                <geometry>
                    <cylinder>
                        <radius>0.04</radius>
                        <length>0.04</length>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>0.1 0.4 0.7 1</ambient>
                    <diffuse>0.1 0.4 0.7 1</diffuse>
                </material>
            </visual>

            <sensor name="lidar" type="gpu_lidar">
                <!-- x = 0.50/4; z = Chassisoberseite 0.10 + 0.05 m -->
                <!-- Scanebene liegt auch über dem Gehäuse (Oberkante 0.14 m) -->
                <pose>0.125 0 0.15 0 0 0</pose>
                <topic>/model/curious_robot/lidar</topic>
                <always_on>true</always_on>
                <update_rate>10</update_rate>
                <visualize>true</visualize>
                <lidar>
                    <scan>
                        <horizontal>
                            <!-- 361 Werte inklusive beider Endpunkte: 1 Grad Abstand -->
                            <samples>361</samples>
                            <resolution>1</resolution>
                            <min_angle>-3.141592653589793</min_angle>
                            <max_angle>3.141592653589793</max_angle>
                        </horizontal>
                        <vertical>
                            <samples>1</samples>
                            <resolution>1</resolution>
                            <min_angle>0</min_angle>
                            <max_angle>0</max_angle>
                        </vertical>
                    </scan>
                    <range>
                        <min>0.1</min>
                        <max>10</max>
                        <resolution>0.01</resolution>
                    </range>
                </lidar>
            </sensor>

        </link>


        <!-- ======================================== -->
        <!-- LINKES RAD                               -->
        <!-- ======================================== -->
        <link name="left_wheel">

            <!-- Achse einen Radradius hinter der Mitte: Schwerpunkt im Stützdreieck -->
            <!-- Radunterkante: -0.10 - 0.10 = -0.20 m -->
            <pose>-0.10 0.23 -0.10 1.5708 0 0</pose>

            <inertial>
                <mass>0.2</mass>

                <inertia>
                    <ixx>0.0005</ixx>
                    <iyy>0.0005</iyy>
                    <izz>0.0005</izz>

                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyz>0</iyz>
                </inertia>
            </inertial>


            <collision name="left_wheel_collision">
                <geometry>
                    <cylinder>
                        <radius>0.10</radius>
                        <length>0.05</length>
                    </cylinder>
                </geometry>
            </collision>


            <visual name="left_wheel_visual">
                <geometry>
                    <cylinder>
                        <radius>0.10</radius>
                        <length>0.05</length>
                    </cylinder>
                </geometry>

                <material>
                    <ambient>0.05 0.05 0.05 1</ambient>
                    <diffuse>0.05 0.05 0.05 1</diffuse>
                </material>
            </visual>

        </link>


        <!-- ======================================== -->
        <!-- RECHTES RAD                              -->
        <!-- ======================================== -->
        <link name="right_wheel">

            <pose>-0.10 -0.23 -0.10 1.5708 0 0</pose>

            <inertial>
                <mass>0.2</mass>

                <inertia>
                    <ixx>0.0005</ixx>
                    <iyy>0.0005</iyy>
                    <izz>0.0005</izz>

                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyz>0</iyz>
                </inertia>
            </inertial>


            <collision name="right_wheel_collision">
                <geometry>
                    <cylinder>
                        <radius>0.10</radius>
                        <length>0.05</length>
                    </cylinder>
                </geometry>
            </collision>


            <visual name="right_wheel_visual">
                <geometry>
                    <cylinder>
                        <radius>0.10</radius>
                        <length>0.05</length>
                    </cylinder>
                </geometry>

                <material>
                    <ambient>0.05 0.05 0.05 1</ambient>
                    <diffuse>0.05 0.05 0.05 1</diffuse>
                </material>
            </visual>

        </link>


        <!-- ======================================== -->
        <!-- PASSIVER CASTER / STÜTZE                 -->
        <!-- ======================================== -->
        <link name="caster_support">

            <!-- Kugelunterkante: -0.16 - 0.04 = -0.20 m, wie bei den Rädern -->
            <pose>0.18 0 -0.16 0 0 0</pose>

            <inertial>
                <mass>0.05</mass>

                <inertia>
                    <ixx>0.00002</ixx>
                    <iyy>0.00002</iyy>
                    <izz>0.00002</izz>

                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyz>0</iyz>
                </inertia>
            </inertial>

            <collision name="caster_collision">
                <geometry>
                    <sphere>
                        <radius>0.04</radius>
                    </sphere>
                </geometry>
            </collision>

            <visual name="caster_visual">
                <geometry>
                    <sphere>
                        <radius>0.04</radius>
                    </sphere>
                </geometry>

                <material>
                    <ambient>0.4 0.4 0.4 1</ambient>
                    <diffuse>0.5 0.5 0.5 1</diffuse>
                </material>
            </visual>

        </link>


        <joint name="caster_joint" type="ball">
            <parent>chassis</parent>
            <child>caster_support</child>
            <pose>0 0 0 0 0 0</pose>
        </joint>


        <!-- ======================================== -->
        <!-- GELENK: CHASSIS -> LINKES RAD            -->
        <!-- ======================================== -->
        <joint name="left_wheel_joint" type="revolute">

            <parent>chassis</parent>
            <child>left_wheel</child>

            <axis>
                <!-- Modell-Y ist die Radachse; der Rad-/Gelenkrahmen ist gedreht -->
                <xyz expressed_in="__model__">0 1 0</xyz>

                <limit>
                    <lower>-1e16</lower>
                    <upper>1e16</upper>
                </limit>
            </axis>

        </joint>


        <!-- ======================================== -->
        <!-- GELENK: CHASSIS -> RECHTES RAD           -->
        <!-- ======================================== -->
        <joint name="right_wheel_joint" type="revolute">

            <parent>chassis</parent>
            <child>right_wheel</child>

            <axis>
                <!-- Modell-Y ist die Radachse; der Rad-/Gelenkrahmen ist gedreht -->
                <xyz expressed_in="__model__">0 1 0</xyz>

                <limit>
                    <lower>-1e16</lower>
                    <upper>1e16</upper>
                </limit>
            </axis>

        </joint>


        <!-- ======================================== -->
        <!-- DIFFERENTIALANTRIEB                      -->
        <!-- ======================================== -->
        <plugin filename="gz-sim-diff-drive-system"
                name="gz::sim::systems::DiffDrive">
            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>

            <!-- Abstand der Radmitten: 0.23 - (-0.23) = 0.46 m -->
            <wheel_separation>0.46</wheel_separation>
            <wheel_radius>0.10</wheel_radius>

            <!-- gz.msgs.Twist: linear.x in m/s, angular.z in rad/s -->
            <topic>/model/curious_robot/cmd_vel</topic>
        </plugin>

    </model>

</sdf>
