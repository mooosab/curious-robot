<?xml version="1.0" ?>

<sdf version="1.9">

    <world name="basic_world">

        <!-- Explizite Plugins ersetzen in Harmonic die Server-Standardplugins. -->
        <!-- Bestehende Physik, GUI-Szene und Befehle deshalb beibehalten. -->
        <plugin filename="gz-sim-physics-system"
                name="gz::sim::systems::Physics"/>
        <plugin filename="gz-sim-user-commands-system"
                name="gz::sim::systems::UserCommands"/>
        <plugin filename="gz-sim-scene-broadcaster-system"
                name="gz::sim::systems::SceneBroadcaster"/>
        <plugin filename="gz-sim-sensors-system"
                name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>

        <!-- ========================= -->
        <!-- SZENE / DARSTELLUNG       -->
        <!-- ========================= -->
        <scene>
            <ambient>0.6 0.6 0.6 1</ambient>
            <background>0.8 0.8 0.8 1</background>
            <shadows>true</shadows>
        </scene>


        <!-- ========================= -->
        <!-- PHYSIK                    -->
        <!-- ========================= -->
        <physics name="physics" type="ignored">
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1.0</real_time_factor>
        </physics>


        <!-- ========================= -->
        <!-- SONNE / BELEUCHTUNG       -->
        <!-- ========================= -->
        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>

            <!-- x y z roll pitch yaw -->
            <pose>0 0 10 0 0 0</pose>

            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>

            <direction>-0.5 0.1 -0.9</direction>
        </light>


        <!-- ========================= -->
        <!-- BODEN                     -->
        <!-- ========================= -->
        <model name="ground">
            <static>true</static>

            <link name="ground_link">

                <!-- Physische Kollisionsfläche -->
                <collision name="ground_collision">
                    <geometry>
                        <box>
                            <size>10 10 0.1</size>
                        </box>
                    </geometry>
                </collision>

                <!-- Sichtbarer Boden -->
                <visual name="ground_visual">
                    <geometry>
                        <box>
                            <size>10 10 0.1</size>
                        </box>
                    </geometry>

                    <material>
                        <ambient>0.7 0.7 0.7 1</ambient>
                        <diffuse>0.7 0.7 0.7 1</diffuse>
                        <specular>0.1 0.1 0.1 1</specular>
                    </material>
                </visual>

            </link>
        </model>


        <!-- ========================= -->
        <!-- WAND HINTEN               -->
        <!-- ========================= -->
        <model name="wall_back">
            <static>true</static>

            <pose>0 5 0.5 0 0 0</pose>

            <link name="wall_link">

                <collision name="collision">
                    <geometry>
                        <box>
                            <size>10 0.2 1</size>
                        </box>
                    </geometry>
                </collision>

                <visual name="visual">
                    <geometry>
                        <box>
                            <size>10 0.2 1</size>
                        </box>
                    </geometry>

                    <material>
                        <ambient>0.9 0.9 0.9 1</ambient>
                        <diffuse>0.9 0.9 0.9 1</diffuse>
                        <specular>0.1 0.1 0.1 1</specular>
                    </material>
                </visual>

            </link>
        </model>


        <!-- ========================= -->
        <!-- WAND VORNE                -->
        <!-- ========================= -->
        <model name="wall_front">
            <static>true</static>

            <pose>0 -5 0.5 0 0 0</pose>

            <link name="wall_link">

                <collision name="collision">
                    <geometry>
                        <box>
                            <size>10 0.2 1</size>
                        </box>
                    </geometry>
                </collision>

                <visual name="visual">
                    <geometry>
                        <box>
                            <size>10 0.2 1</size>
                        </box>
                    </geometry>

                    <material>
                        <ambient>0.9 0.9 0.9 1</ambient>
                        <diffuse>0.9 0.9 0.9 1</diffuse>
                        <specular>0.1 0.1 0.1 1</specular>
                    </material>
                </visual>

            </link>
        </model>


        <!-- ========================= -->
        <!-- WAND LINKS                -->
        <!-- ========================= -->
        <model name="wall_left">
            <static>true</static>

            <pose>-5 0 0.5 0 0 0</pose>

            <link name="wall_link">

                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.2 10 1</size>
                        </box>
                    </geometry>
                </collision>

                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.2 10 1</size>
                        </box>
                    </geometry>

                    <material>
                        <ambient>0.9 0.9 0.9 1</ambient>
                        <diffuse>0.9 0.9 0.9 1</diffuse>
                        <specular>0.1 0.1 0.1 1</specular>
                    </material>
                </visual>

            </link>
        </model>


        <!-- ========================= -->
        <!-- WAND RECHTS               -->
        <!-- ========================= -->
        <model name="wall_right">
            <static>true</static>

            <pose>5 0 0.5 0 0 0</pose>

            <link name="wall_link">

                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.2 10 1</size>
                        </box>
                    </geometry>
                </collision>

                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.2 10 1</size>
                        </box>
                    </geometry>

                    <material>
                        <ambient>0.9 0.9 0.9 1</ambient>
                        <diffuse>0.9 0.9 0.9 1</diffuse>
                        <specular>0.1 0.1 0.1 1</specular>
                    </material>
                </visual>

            </link>
        </model>


        <!-- ========================= -->
        <!-- HINDERNIS 1 - ROT         -->
        <!-- ========================= -->
        <model name="obstacle_1">
            <static>true</static>

            <!-- Position: x=2, y=2 -->
            <pose>2 2 0.5 0 0 0</pose>

            <link name="obstacle_link">

                <collision name="collision">
                    <geometry>
                        <box>
                            <size>1.5 1.0 1.0</size>
                        </box>
                    </geometry>
                </collision>

                <visual name="visual">
                    <geometry>
                        <box>
                            <size>1.5 1.0 1.0</size>
                        </box>
                    </geometry>

                    <material>
                        <ambient>0.8 0.2 0.2 1</ambient>
                        <diffuse>0.8 0.2 0.2 1</diffuse>
                        <specular>0.1 0.1 0.1 1</specular>
                    </material>
                </visual>

            </link>
        </model>


        <!-- ========================= -->
        <!-- HINDERNIS 2 - BLAU        -->
        <!-- ========================= -->
        <model name="obstacle_2">
            <static>true</static>

            <!-- Position: x=-2, y=1 -->
            <pose>-2 1 0.4 0 0 0</pose>

            <link name="obstacle_link">

                <collision name="collision">
                    <geometry>
                        <box>
                            <size>1.0 1.0 0.8</size>
                        </box>
                    </geometry>
                </collision>

                <visual name="visual">
                    <geometry>
                        <box>
                            <size>1.0 1.0 0.8</size>
                        </box>
                    </geometry>

                    <material>
                        <ambient>0.2 0.3 0.8 1</ambient>
                        <diffuse>0.2 0.3 0.8 1</diffuse>
                        <specular>0.1 0.1 0.1 1</specular>
                    </material>
                </visual>

            </link>
        </model>


        <!-- ========================= -->
        <!-- HINDERNIS 3 - GRÜN        -->
        <!-- ========================= -->
        <model name="obstacle_3">
            <static>true</static>

            <!-- Position: x=1, y=-2 -->
            <pose>1 -2 0.6 0 0 0</pose>

            <link name="obstacle_link">

                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.8 1.8 1.2</size>
                        </box>
                    </geometry>
                </collision>

                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.8 1.8 1.2</size>
                        </box>
                    </geometry>

                    <material>
                        <ambient>0.2 0.7 0.3 1</ambient>
                        <diffuse>0.2 0.7 0.3 1</diffuse>
                        <specular>0.1 0.1 0.1 1</specular>
                    </material>
                </visual>

            </link>
        </model>

        <!-- ========================= -->
        <!-- CURIOUS ROBOT             -->
        <!-- ========================= -->
        <include>
            <uri>model://curious_robot</uri>

            <!-- Startposition -->
            <pose>0 0 0.25 0 0 0</pose>
        </include>
    </world>

</sdf>
